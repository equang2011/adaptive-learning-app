# --- Required ---

# LLM Gateway (full /invoke endpoint)
GATEWAY_URL=https://llm-gateway-production-b085.up.railway.app/invoke
GATEWAY_API_KEY=your_api_key_here

# Database. If unset, falls back to a local SQLite file at data/app.db.
# Local Postgres (Docker, port 5433) example:
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/dbname

# --- Optional (defaults shown) ---

# Gateway model alias (not a raw provider ID); must be in the gateway's catalog
LESSON_MODEL=deepseek-v4.1-flash-1017

# Prompt versions
CURRICULUM_PROMPT_VERSION=curriculum_v4.md
LESSON_PROMPT_VERSION=v1
CURRICULUM_EVALUATOR_PROMPT_VERSION=curriculum_evaluator_v1.md
LESSON_EVALUATOR_PROMPT_VERSION=lesson_evaluator_v1.md

# Used by the batch/smoke scripts only (the web UI takes it from the form)
LESSON_DETAIL_LEVEL=standard
